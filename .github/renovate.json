{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable"
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "ansible": {
        "enabled": false
    },
    "baseBranchPatterns": [
        "$default"
    ],
    "constraints": {
        "uv": "0.12.7"
    },
    "pip-compile": {
        "managerFilePatterns": [
            "/(^|/)requirements/requirements-saltbox\\.txt$/"
        ]
    },
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "description": "Saltbox compiled Python requirements",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "requirements/requirements-saltbox.in",
                "requirements/requirements-saltbox.txt"
            ],
            "enabled": false
        },
        {
            "description": "Python is updated from the sb-go uv catalogue",
            "matchManagers": [
                "pyenv"
            ],
            "matchFileNames": [
                ".python-version"
            ],
            "enabled": false
        },
        {
            "description": "uv is managed by sb-go releases",
            "matchManagers": [
                "renovate-config"
            ],
            "matchPackageNames": [
                "uv"
            ],
            "enabled": false
        },
        {
            "description": "Major pip requirements updates",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "requirements/*",
                "resources/roles/dns/files/*"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "pip",
                "major"
            ]
        },
        {
            "description": "pip requirements",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "requirements/*",
                "resources/roles/dns/files/*"
            ],
            "groupName": "pip-requirements",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "pip"
            ]
        },
        {
            "description": "Major GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "github-actions",
                "major"
            ]
        },
        {
            "description": "GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "github-actions"
            ]
        }
    ],
    "rebaseWhen": "conflicted",
    "vulnerabilityAlerts": {
        "enabled": true,
        "addLabels": [
            "security",
            "vulnerability"
        ]
    },
    "commitMessageAction": "Update",
    "commitMessageTopic": "{{depName}}",
    "commitMessageExtra": "to {{newVersion}}",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "before 5am on Monday"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Traefik cloudflarewarp plugin",
            "managerFilePatterns": ["roles/traefik/defaults/main.yml"],
            "matchStrings": [
                "plugins\\.cloudflarewarp\\.version=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "depNameTemplate": "saltyorg/cloudflarewarp",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Traefik themepark plugin",
            "managerFilePatterns": ["roles/traefik/defaults/main.yml"],
            "matchStrings": [
                "plugins\\.themepark\\.version=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "depNameTemplate": "packruler/traefik-themepark",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Traefik crowdsec bouncer plugin",
            "managerFilePatterns": ["roles/traefik/defaults/main.yml"],
            "matchStrings": [
                "plugins\\.bouncer\\.version=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "depNameTemplate": "maxlerebourg/crowdsec-bouncer-traefik-plugin",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        }
    ]
}
