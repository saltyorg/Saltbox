exclude_paths:
  - /.github/
  - /.idea/
  - /.vscode/
  - /ansible_facts.d/
  - /bin/
  - /defaults/
  - /filter_plugins/
  - /inventories/host_vars/
  - /lookup_plugins/
  - /pictures/
  - /requirements/
  - /schema/
  - /scripts/

offline: false

skip_list:
  - command-instead-of-module
  - ignore-errors
  - latest[git]
  - name[casing]
  - name[template]
  - no-changed-when
  - no-handler
  - package-latest
  - risky-shell-pipe
  - schema[playbook]
  - schema[tasks]
  - var-naming[no-role-prefix]
  - yaml[line-length]
  - complexity[tasks]
