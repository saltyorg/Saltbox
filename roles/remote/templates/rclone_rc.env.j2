# RCLONE_RC_* authenticate the mount's rc server.
# RCLONE_USER and RCLONE_PASS authenticate 'rclone rc' clients.
RCLONE_RC_USER={{ user.name | to_json(ensure_ascii=False) }}
RCLONE_RC_PASS={{ user.pass | to_json(ensure_ascii=False) }}
RCLONE_USER={{ user.name | to_json(ensure_ascii=False) }}
RCLONE_PASS={{ user.pass | to_json(ensure_ascii=False) }}
